{
  "name": "kasafund-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:presentation": "node scripts/seed-presentation.js",
    "seed:presentation:reset": "node scripts/seed-presentation.js --reset",
    "seed:presentation:admin": "node scripts/seed-presentation-admin.js",
    "seed:presentation:reports": "node scripts/seed-presentation-reports.js",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.3"
  }
}
