PORT=5050
NODE_ENV=development
ENABLE_PAYOUT_TEST_TOOLS=false
MONGODB_URI=mongodb://127.0.0.1:27017/kasafund
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
APP_SCHEME=kasafund
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=https://api.example.com/api/payments/paystack/callback
PAYSTACK_LIVE_TRANSFERS=false
AUTOMATIC_PAYOUTS_ENABLED=true
PAYOUT_PROCESSOR_INTERVAL_MS=900000
AUTOMATIC_CONTRIBUTIONS_ENABLED=true
AUTO_CONTRIBUTION_PROCESSOR_INTERVAL_MS=900000
AUTOMATIC_SAVINGS_ENABLED=true
SAVINGS_PROCESSOR_INTERVAL_MS=900000

# Presentation seed (use a separate database ending in presentation or demo).
# PRESENTATION_MONGODB_URI=mongodb://127.0.0.1:27017/kasafund_presentation
# PRESENTATION_DEMO_PASSWORD=choose-a-demo-password
# ALLOW_PRESENTATION_SEED=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
DIDIT_API_KEY=your-didit-api-key
DIDIT_WORKFLOW_ID=your-published-kyc-workflow-id
DIDIT_WEBHOOK_SECRET=your-webhook-destination-secret
DIDIT_CALLBACK_URL=kasafund://profile/identity-verification
RESEND_API_KEY=re_replace_me
EMAIL_FROM=KasaFund <verify@your-verified-domain.com>

# Twilio Verify SMS OTP
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VA_replace_me

# Comma-separated OAuth client IDs whose Google ID tokens the API may accept.
# Include the web client ID and every KasaFund native client ID.
GOOGLE_CLIENT_IDS=000000000000-web.apps.googleusercontent.com,000000000000-ios.apps.googleusercontent.com

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=replace-with-a-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_PHONE=233000000000
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-webhook-token
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
WHATSAPP_GRAPH_API_VERSION=v23.0

# Optional: account answers and common FAQs work without Gemini.
GEMINI_API_KEY=replace-with-a-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash
